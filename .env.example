# Optional build-time overrides (copy to .env.production). The defaults live in src/lib/site.ts,
# so the site builds correctly without this file. NEXT_PUBLIC_* values are baked in at build
# time; setting them as Cloudflare runtime variables has no effect on the page.
SITE_URL=https://getin.example.co.uk
NEXT_PUBLIC_WHATSAPP=447463870657
NEXT_PUBLIC_INSTAGRAM=https://www.instagram.com/
NEXT_PUBLIC_SEATS_LEFT=10
# Booking page for the free call; set it to redirect to /booked after booking.
NEXT_PUBLIC_CAL_LINK=
# Google Tag Manager container. When set, a cookie banner asks before loading it.
NEXT_PUBLIC_GTM_ID=
