{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "degreeyourway",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    // Self-reference binding required by OpenNext; must match "name" above.
    { "binding": "WORKER_SELF_REFERENCE", "service": "degreeyourway" }
  ],
  "observability": { "enabled": true },
  // At most 10 lead submissions per minute from one IP address.
  "ratelimits": [
    { "name": "LEAD_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } }
  ],
  // Every lead is also kept here, so none are lost even without LEAD_WEBHOOK_URL.
  // List them with: npx wrangler kv key list --binding LEADS --remote
  "kv_namespaces": [{ "binding": "LEADS", "id": "df0c2e54bb274b3cb3916699ed1b1143" }]
}
